# Copier vers .env (à la racine, à côté de docker-compose.yml) : cp .env.docker.example .env
# Ce fichier .env ne doit JAMAIS être versionné.

# --- Base de données ---
# Mot de passe sans caractères spéciaux (il est inséré dans une URL) : openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=mcoaching
POSTGRES_DB=mcoaching
POSTGRES_PORT=5433

# --- Application ---
# Secret BetterAuth : openssl rand -hex 32  (ne plus le changer : les sessions existantes seraient invalidées)
AUTH_SECRET=
# Adresse publique exacte (utilisée dans les liens des e-mails et par l'authentification).
# En production : https://votre-domaine (derrière un proxy HTTPS).
APP_URL=http://localhost:3600
APP_PORT=3600
APP_TIMEZONE=Africa/Abidjan

# true = lien d'activation envoyé par e-mail (nécessite un SMTP fonctionnel) ;
# false = compte actif d'emblée avec mot de passe provisoire affiché à l'administrateur.
ACTIVATION_BY_EMAIL=false
DISABLE_SCHEDULER=false

# --- E-mails (laisser EMAIL_PROVIDER vide = e-mails écrits dans les journaux du conteneur) ---
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
