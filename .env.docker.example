# Test LOCAL uniquement (sur Coolify, ces valeurs sont générées ou saisies dans l'interface) :
#   cp .env.docker.example .env.docker
#   docker compose -f docker-compose.yml -f docker-compose.local.yml --env-file .env.docker up -d --build

# Équivalents locaux des variables que Coolify génère (SERVICE_*) — sans caractères spéciaux.
SERVICE_USER_POSTGRES=mcoaching
SERVICE_PASSWORD_POSTGRES=              # openssl rand -hex 24
SERVICE_HEX_64_AUTHSECRET=              # openssl rand -hex 32
SERVICE_URL_APP_3600=http://localhost:3600

APP_URL=http://localhost:3600
APP_TIMEZONE=Africa/Abidjan
ACTIVATION_BY_EMAIL=false
DISABLE_SCHEDULER=false

# E-mails (EMAIL_PROVIDER vide = écrits dans les journaux du conteneur)
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
