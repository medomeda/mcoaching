# Base de données dédiée au site (ex. mentora_site) — mot de passe encodé (%40, %21…)
DATABASE_URL=postgresql://mentora_site:CHANGER@127.0.0.1:5432/mentora_site
# SSL : '' | disable | require | no-verify
DATABASE_SSL=
# Hôtes (sans schéma pour ADMIN_HOST) ; SITE_URL avec https://
SITE_URL=http://localhost:3601
ADMIN_HOST=admin.localhost:3601
# Domaine des instances clientes : seules les adresses https://<nom>.<domaine> sont acceptées
INSTANCE_DOMAIN=mentora.app
# 32 octets en base64 : openssl rand -base64 32 (chiffrement des clés d'instance)
MASTER_KEY=
AUTH_SECRET=
# Mentions légales (jamais inventées : à renseigner)
LEGAL_COMPANY_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
# Tests (base d'administration pour créer des bases jetables) — dans .env.local
# SITE_TEST_DATABASE_URL=postgresql://admin:...@127.0.0.1:5032/postgres
# Développement local uniquement : false désactive le second facteur obligatoire (ignoré en production)
# ADMIN_REQUIRE_2FA=false
