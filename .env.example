# true  = démonstration : backend simulé dans le navigateur (seed, horloge simulée, boîte mail de démo).
# false = serveur : PostgreSQL + BetterAuth. NE JAMAIS activer la démo en production.
NEXT_PUBLIC_DEMO_MODE=true

# --- Backend serveur (PRD §19.2) ---
# Encoder les caractères spéciaux du mot de passe dans l'URL : @ → %40, ! → %21, # → %23.
DATABASE_URL=postgresql://USER:MOT_DE_PASSE_ENCODE@127.0.0.1:5432/NOM_DB
# Secret BetterAuth : openssl rand -hex 32
AUTH_SECRET=
APP_URL=http://localhost:3600
APP_TIMEZONE=Africa/Abidjan
# Vide = e-mails écrits dans la console du serveur (développement) ; "smtp" = envoi réel via SMTP_*.
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
PRIVATE_STORAGE_PATH=
# Planificateur intégré au serveur web (une exécution par minute). Mettre à true si les tâches
# sont lancées par un processus séparé ou un cron (`npm run jobs`).
DISABLE_SCHEDULER=false
# true = un compte créé reçoit un lien d'activation par e-mail (72 h) ; false = compte actif d'emblée,
# l'administrateur reçoit un mot de passe provisoire à transmettre (utile tant que l'envoi d'e-mails n'est pas opérationnel).
ACTIVATION_BY_EMAIL=false
